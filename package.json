{
  "name": "deathstalker-rpg",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "npm run typecheck",
    "typecheck": "tsc -p tsconfig.core.json && tsc --noEmit",
    "test": "vitest run",
    "test:compact": "vitest run --reporter=dot",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "lint:errors": "eslint . --quiet",
    "sim": "tsx src/sim/index.ts",
    "sim:diff": "tsx src/sim/simDiff.ts",
    "balance:smoke": "tsx src/sim/balanceCheck.ts --iterations 50 --summary",
    "balance-check": "tsx src/sim/balanceCheck.ts",
    "opening-check": "tsx src/sim/openingExpeditionCheck.ts",
    "godot:fixture": "tsx scripts/export-godot-presentation.ts",
    "godot:opening": "tsx scripts/export-godot-opening-expedition.ts",
    "godot:world-loop": "tsx scripts/export-godot-world-loop.ts",
    "godot:web:core": "vite build --config vite.godot-core.config.ts",
    "godot:assets:validate": "node scripts/validate-godot-combatant-raster-package.mjs --self-test",
    "godot:audio:stage": "node scripts/stage-licensed-combat-audio.mjs",
    "gemini:compare": "node scripts/run-gemini-media-compare.mjs",
    "project:status": "node scripts/project-status.mjs",
    "verify:quick": "node scripts/verify.mjs quick",
    "verify:quality": "node scripts/verify.mjs quality",
    "verify:gameplay": "node scripts/verify.mjs gameplay"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.4",
    "eslint": "^9.20.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
